# Server Config
PORT=3000
FLARE_RPC_URL=https://coston2-api.flare.network/ext/C/rpc

# --- CREDENTIALS ---

# 1. YOUR BACKEND WALLET KEY
# This is the key YOU generated (Method 1 or 2).
# Your backend uses this to sign transactions.
OPERATOR_PRIVATE_KEY=0x4c0883a69102937d6231471b5dbb6204fe5129617082792ae468d01a3f5917d1

# Alias: Add this line so if any shared script uses "PRIVATE_KEY", it works.
PRIVATE_KEY=0x4c0883a69102937d6231471b5dbb6204fe5129617082792ae468d01a3f5917d1

# 2. THE CONTRACT ADDRESS
# The Contracts Guy will give this to you AFTER he runs "npx hardhat run scripts/deploy.js".
# Ask him: "Send me the deployed address for FlareGuardRiskAccount."
RISK_CONTRACT_ADDRESS=0xPasteTheAddressHeGivesYouHere...

# Alias: Add this line to match his naming convention.
SMART_ACCOUNT_ADDRESS=0xPasteTheAddressHeGivesYouHere...