{
  "manifest_version": 3,
  "name": "FlareGuard",
  "description": "Heads-up crypto risk monitor leveraging Flare Network data, FTSO feeds, and smart account protections.",
  "version": "0.1.0",
  "action": {
    "default_popup": "extension/popup.html",
    "default_icon": {
      "16": "extension/icons/icon16.png",
      "48": "extension/icons/icon48.png",
      "128": "extension/icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "extension/background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://*.flare.network/*",
    "https://*.thirdweb.com/*",
    "https://*.thirdwebstorage.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.uniswap.org/*",
        "*://*.pancakeswap.finance/*",
        "*://*.sushidex.com/*",
        "*://*.curve.fi/*",
        "<all_urls>"
      ],
      "js": [
        "extension/content-script.js"
      ],
      "css": [
        "extension/content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "extension/injected.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "icons": {
    "16": "extension/icons/icon16.png",
    "48": "extension/icons/icon48.png",
    "128": "extension/icons/icon128.png"
  }
}
