{
  "manifest_version": 3,
  "name": "FlareGuard",
  "description": "Browser extension HUD for monitoring Flare Network risk signals in real time.",
  "version": "0.1.0",
  "action": {
    "default_title": "FlareGuard",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon-16.png",
      "48": "icon-48.png",
      "128": "icon-128.png"
    }
  },
  "permissions": [
    "storage",
    "alarms",
    "activeTab",
    "tabs"
  ],
  "background": {
    "service_worker": "assets/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "assets/content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
